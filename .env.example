# =============================================================
# MediNear Backend – Environment Variables
# Copy this file to .env for local development.
# On Railway/Render, set these as environment variables in the dashboard.
# =============================================================

# --- Database (Supabase PostgreSQL) ---
DB_URL=jdbc:postgresql://db.<project>.supabase.co:5432/postgres?sslmode=require
DB_USERNAME=postgres
DB_PASSWORD=your_supabase_db_password

# --- Supabase ---
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_PUBLISH_KEY=sb_publishable_...

# --- JWT ---
JWT_SECRET=your_256bit_hex_secret
JWT_EXPIRATION_MS=86400000

# --- CORS (comma-separated, no trailing slash) ---
# Add your Vercel frontend URL here
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# --- Server ---
# Railway injects PORT automatically; leave unset locally
# PORT=8080
