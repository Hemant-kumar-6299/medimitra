# =============================================================
# MediNear Backend – Environment Variables
# Copy this file to .env for local development.
# On Railway/Render, set these as environment variables in the dashboard.
# =============================================================

# --- Database (Supabase PostgreSQL via IPv4 pooler) ---
# Do NOT use db.<project>.supabase.co:5432 on Railway — that host is IPv6-only
# and the app will crash on startup with a connection error.
# Use Session mode pooler (port 5432) + username postgres.<project-ref>.
# Region for this project: ap-northeast-2
DB_URL=jdbc:postgresql://aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres?sslmode=require
DB_USERNAME=postgres.xfsubnzzyspzycyyjjrq
DB_PASSWORD=your_supabase_db_password

# --- Supabase ---
SUPABASE_URL=https://xfsubnzzyspzycyyjjrq.supabase.co
SUPABASE_PUBLISH_KEY=sb_publishable_...

# --- JWT ---
JWT_SECRET=your_256bit_hex_secret
JWT_EXPIRATION_MS=86400000

# --- CORS (comma-separated, no trailing slash) ---
# Add your Vercel frontend URL here
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# --- Server ---
# Railway injects PORT automatically; leave unset locally
# PORT=8080
